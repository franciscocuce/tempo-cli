# Copiá este archivo a .env y completá los valores. .env está en .gitignore.

# OBLIGATORIA. Cifra las URLs de los webhooks guardados (AES-256-GCM).
# Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la cambiás, los canales ya guardados dejan de poder descifrarse y el dashboard
# los muestra como "no se puede descifrar".
TEMPO_SECRET_KEY=

# Dónde vive tempo.db (y sus archivos -wal/-shm). Por defecto ~/.tempo
# En Docker lo fija el compose en /data, que es el volumen persistente.
# TEMPO_DATA_DIR=/data

# Interfaz y puerto donde escucha `tempo serve`.
# El default es 127.0.0.1 a propósito: exponerlo a la red tiene que ser una decisión.
# Los flags --host y --port le ganan a estas variables.
# TEMPO_HOST=127.0.0.1
# TEMPO_PORT=3000

# Solo para docker compose: en qué puerto de tu máquina se publica el contenedor.
# Cambialo si ya tenés algo escuchando en el 3000.
# TEMPO_PUBLISH_PORT=3000

# Detrás de un reverse proxy (nginx, Caddy, Traefik). Sin esto el rate limit ve la IP
# del proxy y no la del visitante, así que un solo atacante consume el cupo de todos.
# Acepta "true", "false" o la cantidad de saltos de proxy.
# TEMPO_TRUST_PROXY=1

# Marca las cookies como Secure (solo se mandan por HTTPS). Se activa solo cuando
# NODE_ENV=production; poné 1 si servís por HTTPS con otro NODE_ENV.
# TEMPO_SECURE_COOKIES=1

# Permite monitorear direcciones privadas (localhost, 10.x, 192.168.x, 169.254.x).
# Es para desarrollo. En un servidor expuesto, dejalo apagado: el guard anti-SSRF es
# lo que impide que un monitor apunte a la metadata de la nube y filtre credenciales.
# TEMPO_ALLOW_PRIVATE_TARGETS=1

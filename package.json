{
  "name": "tempo",
  "version": "0.2.0",
  "description": "Monitor de uptime self-hosted con motor cron propio, en Node + TypeScript",
  "type": "module",
  "bin": {
    "tempo": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "cli": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "tsx src/index.ts serve",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "web": "npm run dashboard:build && npm run serve"
  },
  "keywords": [
    "uptime",
    "monitoring",
    "status-page",
    "cron",
    "self-hosted",
    "typescript"
  ],
  "author": "Francisco Cuce",
  "license": "MIT",
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.0.2"
  }
}
